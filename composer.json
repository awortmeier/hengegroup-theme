{
    "name": "hengegroup-theme/theme",
    "description": "Dev-Tooling (WPCS-Lint, PHPUnit, siehe CLAUDE.md Regel 11) sowie die eine echte Laufzeit-Abhaengigkeit dieses Themes (enshrined/svg-sanitize fuer SVG-Uploads, siehe inc/setup/theme-svg-support.php und docs/entscheidungen.md).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "enshrined/svg-sanitize": "^1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "php-stubs/wordpress-stubs": "^7.0",
        "phpunit/phpunit": "^11.5",
        "brain/monkey": "^2.7"
    },
    "autoload-dev": {
        "psr-4": {
            "BaseTheme\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit"
    }
}
