{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/produktkategorie",
    "title": "Produktkategorie",
    "category": "henge",
    "icon": "category",
    "description": "Sektion einer Produktkategorie: Kicker, Überschrift und Beschreibung (leer = aus der Kategorie), darunter automatisch alle Produkte dieser Kategorie.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "categoryId": {
            "type": "number",
            "default": 0
        },
        "background": {
            "type": "string",
            "enum": ["light", "muted"],
            "default": "light"
        },
        "kicker": {
            "type": "string",
            "default": ""
        },
        "kickerVariant": {
            "type": "string",
            "default": ""
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "headingTag": {
            "type": "string",
            "default": "h2"
        },
        "text": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-produktkategorie-editor",
    "render": "file:./render.php"
}
