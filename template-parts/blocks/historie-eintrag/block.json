{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/historie-eintrag",
    "title": "Historie-Eintrag",
    "category": "henge",
    "icon": "backup",
    "description": "Ein Eintrag im Block „Historie“: Jahr, Titel, Text und Akzentfarbe des Punkts.",
    "textdomain": "hengegroup-theme",
    "parent": ["hengegroup-theme/historie"],
    "attributes": {
        "year": {
            "type": "string",
            "default": ""
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "accent": {
            "type": "string",
            "default": "henge-green"
        },
        "variant": {
            "type": "string",
            "enum": ["default", "ghost"],
            "default": "default"
        }
    },
    "supports": {
        "html": false,
        "reusable": false
    },
    "render": "file:./render.php"
}
