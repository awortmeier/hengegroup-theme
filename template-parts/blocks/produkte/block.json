{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/produkte",
    "title": "Produkte",
    "category": "henge",
    "icon": "cart",
    "description": "Dunkle Sektion mit Überschrift, Text, Call-to-Action und einem Raster ausgewählter WooCommerce-Produkte.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "headingTag": {
            "type": "string",
            "default": "p"
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "buttonText": {
            "type": "string",
            "default": ""
        },
        "buttonUrl": {
            "type": "string",
            "default": ""
        },
        "productCategory": {
            "type": "string",
            "default": ""
        },
        "numberOfProducts": {
            "type": "number",
            "default": 4
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-produkte-editor",
    "render": "file:./render.php"
}
