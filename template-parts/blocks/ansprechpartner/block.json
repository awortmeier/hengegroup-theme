{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/ansprechpartner",
    "title": "Ansprechpartner",
    "category": "henge",
    "icon": "id",
    "description": "Graue Sektion mit Überschrift und Kontaktkarten (oben Name und Funktion in der Akzentfarbe, unten E-Mail, Telefon und Fax). Personen direkt im Block hinzufügen.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Ansprechpartner"
        },
        "headingTag": {
            "type": "string",
            "default": "h2"
        },
        "accent": {
            "type": "string",
            "default": "henge-grey"
        },
        "layout": {
            "type": "string",
            "default": "grid-4"
        },
        "background": {
            "type": "string",
            "enum": ["light", "muted", "dark"],
            "default": "muted"
        },
        "spacing": {
            "type": "string",
            "enum": ["both", "top", "bottom"],
            "default": "both"
        }
    },
    "providesContext": {
        "hengegroup-theme/ansprechpartner-accent": "accent"
    },
    "allowedBlocks": ["hengegroup-theme/ansprechpartner-person"],
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-ansprechpartner-editor",
    "render": "file:./render.php"
}
