{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/kontakt",
    "title": "Kontakt",
    "category": "henge",
    "icon": "email",
    "description": "Kontakt-Sektion mit Kontaktkarte und Anfrageformular. Ohne eigene Kontaktdaten zeigt die Karte die Daten aus Einstellungen > Footer. Anfragen landen im Menüpunkt Produktanfragen.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Kontakt"
        },
        "text": {
            "type": "string",
            "default": "Sie haben einen bestimmten Wunsch oder Fragen zu unserem Leistungsspektrum? Dann nehmen Sie einfach über das Formular oder per Telefon Kontakt mit uns auf. Wir freuen uns auf Ihre Anfrage."
        },
        "accent": {
            "type": "string",
            "default": "henge-grey"
        },
        "contactName": {
            "type": "string",
            "default": ""
        },
        "contactEmail": {
            "type": "string",
            "default": ""
        },
        "contactPhone": {
            "type": "string",
            "default": ""
        },
        "contactFax": {
            "type": "string",
            "default": ""
        },
        "contactAddress": {
            "type": "string",
            "default": ""
        },
        "background": {
            "type": "string",
            "enum": ["light", "muted", "dark"],
            "default": "light"
        },
        "spacing": {
            "type": "string",
            "enum": ["both", "top", "bottom"],
            "default": "both"
        }
    },
    "supports": {
        "html": false,
        "multiple": false
    },
    "editorScript": "hengegroup-theme-kontakt-editor",
    "render": "file:./render.php"
}
