{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/anwendungsgruppe",
    "title": "Anwendungsgruppe",
    "category": "henge",
    "icon": "screenoptions",
    "description": "Sektion einer Anwendungsgruppe: Kicker, Überschrift und Beschreibung (leer = aus der Gruppe), darunter automatisch alle Anwendungen der Gruppe mit ihren Produkten.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "groupId": {
            "type": "number",
            "default": 0
        },
        "background": {
            "type": "string",
            "enum": ["light", "muted", "dark"],
            "default": "light"
        },
        "kicker": {
            "type": "string",
            "default": ""
        },
        "kickerVariant": {
            "type": "string",
            "default": ""
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "headingTag": {
            "type": "string",
            "default": "h2"
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "spacing": {
            "type": "string",
            "enum": ["both", "top", "bottom"],
            "default": "both"
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-anwendungsgruppe-editor",
    "render": "file:./render.php"
}
