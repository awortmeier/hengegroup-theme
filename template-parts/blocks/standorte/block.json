{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/standorte",
    "title": "Standorte",
    "category": "henge",
    "icon": "location",
    "description": "Überschrift und Standort-Karten (oben Name und Adresse in der Akzentfarbe, unten Öffnungs- bzw. Ladezeiten). Standorte direkt im Block hinzufügen.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Standorte"
        },
        "headingTag": {
            "type": "string",
            "default": "h2"
        },
        "accent": {
            "type": "string",
            "default": "henge-grey"
        },
        "layout": {
            "type": "string",
            "default": "grid-4"
        }
    },
    "providesContext": {
        "hengegroup-theme/standorte-accent": "accent"
    },
    "allowedBlocks": ["hengegroup-theme/standort"],
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-standorte-editor",
    "render": "file:./render.php"
}
