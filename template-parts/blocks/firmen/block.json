{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/firmen",
    "title": "Unternehmen der Gruppe",
    "category": "henge",
    "icon": "building",
    "description": "Überschrift und Karten mit Logo, Text und Link je Unternehmen. Unternehmen direkt im Block hinzufügen.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "headingTag": {
            "type": "string",
            "default": "h2"
        },
        "layout": {
            "type": "string",
            "default": "default"
        },
        "background": {
            "type": "string",
            "enum": ["light", "muted", "dark"],
            "default": "muted"
        },
        "spacing": {
            "type": "string",
            "enum": ["both", "top", "bottom"],
            "default": "both"
        }
    },
    "allowedBlocks": ["hengegroup-theme/firma"],
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-firmen-editor",
    "render": "file:./render.php"
}
