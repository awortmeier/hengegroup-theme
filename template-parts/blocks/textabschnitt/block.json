{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/textabschnitt",
    "title": "Textabschnitt",
    "category": "henge",
    "icon": "heading",
    "description": "Zentrierte oder linksbündige Überschrift mit Text. Einzelne Wörter über „Akzent-Schrift“ in der Werkzeugleiste hervorheben.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "headingTag": {
            "type": "string",
            "default": "p"
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "textAlign": {
            "type": "string",
            "default": "center"
        },
        "containerWidth": {
            "type": "string",
            "default": "small"
        },
        "spacingBottom": {
            "type": "boolean",
            "default": true
        },
        "background": {
            "type": "string",
            "enum": ["light", "muted", "dark"],
            "default": "light"
        },
        "spacing": {
            "type": "string",
            "enum": ["both", "top", "bottom"],
            "default": "both"
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "hengegroup-theme-textabschnitt-editor",
    "render": "file:./render.php"
}
