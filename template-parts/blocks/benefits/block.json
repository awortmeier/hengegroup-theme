{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hengegroup-theme/benefits",
    "title": "Benefits",
    "category": "henge",
    "icon": "awards",
    "description": "Überschrift, Einleitung und ein Raster aus Benefits (Icon, Titel, Text) auf dunkler Fläche, jeder Benefit als Karte oder transparent. Benefits direkt im Block hinzufügen.",
    "textdomain": "hengegroup-theme",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "headingTag": {
            "type": "string",
            "default": "h2"
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "variant": {
            "type": "string",
            "default": "list"
        },
        "layout": {
            "type": "string",
            "default": "default"
        }
    },
    "providesContext": {
        "hengegroup-theme/benefitsVariant": "variant"
    },
    "allowedBlocks": ["hengegroup-theme/benefit"],
    "supports": {
        "anchor": true,
        "html": false
    },
    "editorScript": "hengegroup-theme-benefits-editor",
    "render": "file:./render.php"
}
