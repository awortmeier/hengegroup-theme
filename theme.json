{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "palette": [
                {
                    "slug": "accent",
                    "name": "Henge Green",
                    "color": "#3b875e"
                },
                {
                    "slug": "henge-blue",
                    "name": "Henge Blue",
                    "color": "#075f8f"
                },
                {
                    "slug": "henge-grey",
                    "name": "Henge Grey",
                    "color": "#646a6c"
                }
            ]
        },
        "layout": {
            "contentSize": "48rem",
            "wideSize": "72rem"
        },
        "spacing": {
            "units": ["px", "rem", "%", "vw", "vh"]
        },
        "typography": {
            "fluid": true
        }
    },
    "styles": {
        "color": {
            "background": "#fafafa",
            "text": "#262626"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "#3b875e"
                }
            }
        }
    }
}
