{
    "name": "hengegroup-theme",
    "version": "1.0.0",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "clean": "node scripts/run.mjs clean",
        "version": "node scripts/run.mjs sync-theme-version",
        "sync-theme-version": "node scripts/run.mjs sync-theme-version --no-git-add",
        "sync-theme-tokens": "node scripts/run.mjs sync-theme-tokens",
        "build:assets": "vite build",
        "build:theme": "node scripts/run.mjs build",
        "build": "pnpm run build:theme",
        "deploy:all": "node scripts/run.mjs deploy",
        "deploy:changed": "node scripts/run.mjs deploy-changed",
        "i18n": "node scripts/run.mjs i18n-make-pot",
        "i18n:compile": "php scripts/i18n-compile-mo.php languages/de_DE.po languages/en_GB.po",
        "i18n:pot": "node scripts/run.mjs i18n-make-pot",
        "icons:lucide": "node scripts/run.mjs sync-lucide-icons",
        "icons:tabler": "node scripts/run.mjs sync-tabler-icons",
        "format": "prettier --write \"**/*.{css,js,json,md,php}\"",
        "format:check": "prettier --check \"**/*.{css,js,json,md,php}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "audit": "pnpm audit",
        "prepare": "husky"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.24.0",
        "@tabler/icons": "^3.46.0",
        "@tailwindcss/vite": "^4.3.3",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.3.0",
        "lucide-static": "^1.31.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.php": [
            "prettier --write",
            "vendor/bin/phpcs"
        ],
        "*.{css,js,json,md}": "prettier --write"
    }
}
