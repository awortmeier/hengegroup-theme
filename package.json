{
    "name": "hengegroup-theme",
    "version": "1.0.0",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "clean": "bash scripts/clean.sh",
        "version": "bash scripts/sync-theme-version.sh",
        "sync-theme-version": "bash scripts/sync-theme-version.sh --no-git-add",
        "sync-theme-tokens": "bash scripts/sync-theme-tokens.sh",
        "build:assets": "vite build && vite build --config vite.config.editor.js && vite build --config vite.config.editor-ueberschrift-text.js && vite build --config vite.config.editor-produkte.js && vite build --config vite.config.editor-customizations.js && vite build --config vite.config.editor-offene-stellen.js && vite build --config vite.config.editor-karriere-teaser.js && vite build --config vite.config.editor-benefits.js && vite build --config vite.config.editor-auszeichnungen.js && vite build --config vite.config.editor-galerie.js && vite build --config vite.config.editor-stellen-liste.js && vite build --config vite.config.editor-produktkategorie.js && vite build --config vite.config.editor-kontakt.js",
        "build:theme": "bash scripts/build.sh",
        "build": "pnpm run build:theme",
        "deploy:all": "bash scripts/deploy.sh",
        "deploy:changed": "bash scripts/deploy-changed.sh",
        "i18n": "bash scripts/i18n-make-pot.sh",
        "i18n:compile": "php scripts/i18n-compile-mo.php languages/de_DE.po languages/en_GB.po",
        "i18n:pot": "bash scripts/i18n-make-pot.sh",
        "icons:lucide": "bash scripts/sync-lucide-icons.sh",
        "icons:tabler": "bash scripts/sync-tabler-icons.sh",
        "format": "prettier --write \"**/*.{css,js,json,md,php}\"",
        "format:check": "prettier --check \"**/*.{css,js,json,md,php}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "audit": "pnpm audit",
        "prepare": "husky"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.24.0",
        "@tabler/icons": "^3.46.0",
        "@tailwindcss/vite": "^4.3.3",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.3.0",
        "lucide-static": "^1.31.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.php": [
            "prettier --write",
            "vendor/bin/phpcs"
        ],
        "*.{css,js,json,md}": "prettier --write"
    }
}
